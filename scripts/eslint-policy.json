		],
		"no-useless-concat": [
			"warn"
		],
		"no-useless-escape": [
			"warn"
		],
		"no-useless-rename": [
			"warn",
			{
				"ignoreDestructuring": false,
				"ignoreImport": false,
				"ignoreExport": false
			}
		],
		"no-with": [
