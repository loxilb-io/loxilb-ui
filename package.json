{
	"name": "loxilb-ui",
	"version": "0.9.0",
	"private": true,
	"description": "Web dashboard for managing LoxiLB load balancers and network services",
	"license": "Apache-2.0",
	"author": "NetLOX Inc.",
	"repository": {
		"type": "git",
		"url": "https://github.com/loxilb-io/loxilb-ui.git"
	},
	"keywords": [
		"loxilb",
		"load-balancer",
		"dashboard",
		"networking",
		"ebpf",
		"react"
	],
	"homepage": "",
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@mui/icons-material": "^6.4.0",
		"@mui/material": "^6.4.3",
		"@mui/x-charts": "^7.26.0",
		"@mui/x-data-grid": "^7.23.6",
		"@mui/x-date-pickers": "^7.25.0",
		"@tanstack/query-sync-storage-persister": "^5.79.0",
		"@tanstack/react-query": "^5.66.0",
		"@tanstack/react-query-persist-client": "^5.79.0",
		"@types/node": "^16.11.31",
		"@types/react": "^18.0.8",
		"@types/react-dom": "^18.0.0",
		"@types/react-grid-layout": "^1.3.5",
		"archiver": "^8.0.0",
		"date-fns": "^4.1.0",
		"dayjs": "^1.11.13",
		"dotenv": "^17.2.1",
		"glob": "^13.0.6",
		"i18next": "^23.16.8",
		"ogl": "^1.0.11",
		"react": "^18.1.0",
		"react-dom": "^18.1.0",
		"react-grid-layout": "^1.5.0",
		"react-hook-form": "^7.83.0",
		"react-i18next": "^14.1.2",
		"react-query": "^3.39.3",
		"react-router-dom": "^7.1.1",
		"react-scripts": "5.0.1",
		"recoil": "^0.7.7",
		"typescript": "^4.9.5",
		"web-vitals": "^2.1.4"
	},
	"scripts": {
		"gen:api": "node scripts/gen-api-types.mjs",
		"gen:api:check": "npm run gen:api && git diff --exit-code -- src/api/gen",
		"api:check-mapping": "node scripts/check-api-mapping.mjs",
		"api:coverage": "node scripts/check-api-mapping.mjs --coverage",
		"sync:specs": "bash scripts/sync-specs.sh",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"start": "HTTPS=false WDS_SOCKET_PORT=0 HOST=0.0.0.0 dotenv -e .env.development react-scripts start",
		"build": "dotenv -e .env.local react-scripts build",
		"build:dev": "dotenv -e .env.development react-scripts build",
		"build:prod": "dotenv -e .env.production react-scripts build",
		"e2e": "playwright test",
		"e2e:headed": "playwright test --headed",
		"e2e:cicd": "playwright test tests/cicd"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@types/archiver": "^8.0.0",
		"dotenv-cli": "^11.0.0",
		"jsdom": "^29.1.1",
		"openapi-typescript": "^6.7.6",
		"playwright": "^1.61.1",
		"swagger2openapi": "^7.0.8",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10"
	}
}
