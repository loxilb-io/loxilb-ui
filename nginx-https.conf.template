# TLS server (SSL_MODE=enabled with a generated self-signed certificate, or
# SSL_MODE=commercial with certificates you mount).

# Plain-HTTP listener: answers health probes and redirects everything else.
server {
    listen ${HTTP_PORT};
    listen [::]:${HTTP_PORT};
    server_name _;

    # Load balancers probe over HTTP; a 301 here would make them mark the
    # container unhealthy.
    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "healthy\n";
    }

    # Redirect to the client's own hostname ($host), not to server_name. The
    # previous config hardcoded `server_name localhost` and redirected to
    # https://localhost/…, which sent every real deployment to the wrong host.
    # ${HTTPS_REDIRECT_PORT} is empty unless the TLS port is published on a
    # non-default port (Compose maps 3443, so it sets ":3443").
    location / {
        return 301 https://$host${HTTPS_REDIRECT_PORT}$request_uri;
    }
}

server {
    listen ${HTTPS_PORT} ssl;
    listen [::]:${HTTPS_PORT} ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;

    # TLS 1.2 + 1.3 only. The 1.2 suites are the forward-secret AEAD set;
    # 1.3 negotiates its own suites and ignores this list.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Only meaningful on the TLS listener — see the note in the shared include.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include /etc/nginx/snippets/app.conf;
}
