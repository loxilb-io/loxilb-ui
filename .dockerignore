# Node modules and build artifacts
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
build
dist

# Environment files — keep .env.production/.development/.test (the build reads
# them); exclude local overrides so a developer's .env.local never leaks into
# the image (it would override REACT_APP_API_URL with a machine-specific value).
.env.local
.env.*.local

# Logs
/logs/
*.log

# Docker files
Dockerfile*
docker-compose*
.dockerignore

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Misc
README.md
*.md
