# Version control and CI
.git
.github
.gitignore
.gitleaks.toml

# Node modules and build artifacts — npm ci reinstalls from the lockfile, and a
# host-built `build/` would otherwise be copied in and shadowed confusingly.
node_modules
build
dist
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/

# Environment files — keep .env.production/.development/.test (the build reads
# them); exclude local overrides so a developer's .env.local never leaks into
# the image (it would override REACT_APP_API_URL with a machine-specific value).
.env.local
.env.*.local

# Local certificates and logs
ssl/
/logs/
*.log

# Tests and their artifacts: not needed to build the SPA, and the e2e tree
# carries fixtures and testbed configuration that must not enter the image.
e2e/
playwright.config.ts
playwright-report/
test-results/
.playwright-mcp/
.auth/

# Deployment manifests and internal docs (never shipped inside the image)
k8s/
deploy/
docs/internal/

# Docker files
Dockerfile*
docker-compose*
.dockerignore

# AI-assistant tooling / editor
.claude/
.serena/
.codegraph/
.vscode
.idea
CLAUDE.md
**/CLAUDE.md
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docs
*.md
