# Production build flags — NO secrets, NO deployment-specific values (those
# come from the environment: Dockerfile ARG/ENV, release workflow env).
# This file is tracked because `npm run build:prod` reads it via dotenv-cli,
# which silently proceeds when the file is missing — an untracked copy meant
# clean checkouts built the release with none of these flags applied.
#
# The Dockerfile builder stage states the same flags as ENV; CI enforces the
# agreement (see .github/workflows/ci.yml "Build-flag agreement").

# CSP: the certified policy has no script-src 'unsafe-inline' — the CRA
# webpack runtime must be emitted as a file, never inlined into index.html.
INLINE_RUNTIME_CHUNK=false

# No source maps in release artifacts.
GENERATE_SOURCEMAP=false
