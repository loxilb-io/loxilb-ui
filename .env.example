# Copy this file to .env.development / .env.local / .env.production and
# adjust the values for your environment. Never commit real endpoint URLs.

# OAM API base URL. The OAM backend serves its routes under /oam (e.g.
# /oam/health, /oam/login) — mind the two modes below, they differ by ONE path
# segment and mixing them up yields 404s on every request:
#
#   - Development (npm start): NO proxy runs, so this must be the DIRECT OAM
#     base ending in /oam — e.g. http://<oam-host>:8080/oam
#     ⚠ NOT /api/oam here. /api/oam is the edge alias, which only exists in a
#       deployed edge (below); against OAM directly it 404s.
#
#   - Production (deployed edge): keep the same-origin proxied path /api/oam.
#     The edge — Caddy in the recommended loxilb-oam Compose bundle, or nginx in
#     the standalone UI container — rewrites /api/oam/* → <backend>/oam/*.
#     Bundle:     set OAM_UPSTREAM   (see loxilb-oam deploy/compose/.env.example)
#     Standalone: set BACKEND_URL    (see the nginx vars below)
REACT_APP_API_URL=/api/oam

# Environment name: local | production
REACT_APP_ENV=local

# Public URL prefix the app is served under
REACT_APP_PUBLIC_URL=/netlox

# Dev server
PORT=3000
HTTPS=true
WDS_SOCKET_PORT=0

# Standalone UI container (nginx) variables — see docker-entrypoint.sh. These
# apply ONLY to the standalone image; the recommended loxilb-oam Compose bundle
# uses a Caddy edge configured via SITE_ADDRESS / EDGE_TLS / OAM_UPSTREAM
# instead (see loxilb-oam deploy/compose/.env.example). BACKEND_URL is the OAM
# base the nginx edge proxies /api/oam/* to; it must reach OAM's /oam routes.
# BACKEND_URL=http://your-backend:8080
# BACKEND_HOST=your-backend
# FRONTEND_URL=http://localhost:3000
# PUBLIC_PATH=/netlox
