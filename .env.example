# Copy this file to .env.development / .env.local / .env.production and
# adjust the values for your environment. Never commit real endpoint URLs.

# OAM API base URL. The OAM backend serves its routes under /oam (e.g.
# /oam/health, /oam/login) — mind the two modes below, they differ by ONE path
# segment and mixing them up yields 404s on every request:
#
#   - Development (npm start): NO proxy runs, so this must be the DIRECT OAM
#     base ending in /oam — e.g. http://<oam-host>:8080/oam
#     ⚠ NOT /api/oam here. /api/oam is the edge alias, which only exists in a
#       deployed edge (below); against OAM directly it 404s.
#
#   - Production (deployed edge): keep the same-origin proxied path /api/oam.
#     The edge — Caddy in the recommended loxilb-oam Compose bundle, or nginx in
#     the standalone UI container — rewrites /api/oam/* → <backend>/oam/*.
#     Bundle:     set OAM_UPSTREAM   (see loxilb-oam deploy/compose/.env.example)
#     Standalone: set BACKEND_URL    (see the nginx vars below)
REACT_APP_API_URL=/api/oam

# Environment name: local | production
REACT_APP_ENV=local

# Public URL prefix the app is served under
REACT_APP_PUBLIC_URL=/netlox

# Dev server. Note: `npm start` pins HTTPS=false; to serve the dev server over
# HTTPS, run react-scripts directly with HTTPS=true.
PORT=3000
HTTPS=false
WDS_SOCKET_PORT=0

# ─────────────────────────────────────────────────────────────────────────────
# Standalone UI container — read by docker-compose.yml and the image's
# entrypoint. Full reference: docs/container-image.md.
#
# These apply ONLY to the standalone image. The recommended loxilb-oam Compose
# bundle uses a Caddy edge configured via SITE_ADDRESS / EDGE_TLS /
# OAM_UPSTREAM instead (see loxilb-oam deploy/compose/.env.example). Both edges
# expose the same browser path, /api/oam/*, rewritten to OAM's /oam/* routes.
# ─────────────────────────────────────────────────────────────────────────────

# Which image to run. Pin UI_TAG to an immutable release for anything but a lab.
# UI_IMAGE=ghcr.io/loxilb-io/loxilb-ui
# UI_TAG=v0.9.8.7

# TLS mode: disabled (HTTP only) | enabled (self-signed) | commercial (mounted)
# SSL_MODE=enabled

# OAM API base the container proxies /api/oam/* to. It must reach OAM's /oam
# routes. Without it the SPA loads but every API call returns 502.
# BACKEND_URL=http://your-backend:8080
# Host header sent to the backend; derived from BACKEND_URL when left empty.
# BACKEND_HOST=
# Verify the backend's TLS chain — turn on once the backend has a trusted cert.
# BACKEND_TLS_VERIFY=off
# Browser-facing origin, forwarded to OAM as Origin (matched against its
# OAM_ALLOWED_ORIGINS allowlist).
# FRONTEND_URL=http://localhost:3000
# Prefix the SPA is served under; must match the image's REACT_APP_PUBLIC_URL.
# PUBLIC_PATH=/netlox

# Published host ports.
# UI_HTTP_PORT=3000
# UI_HTTPS_PORT=3443

# Version stamped into an image built from this checkout
# (docker-compose.build.yml). Unset builds honestly report "dev".
# UI_VERSION=v0.9.8.7
