# Copy this file to .env.development / .env.local / .env.production and
# adjust the values for your environment. Never commit real endpoint URLs.

# OAM API base URL.
#  - Development (npm start): direct URL of your OAM backend, e.g. https://oam.example.com/oam
#  - Production (Docker/nginx): keep the proxied path /api/oam and set BACKEND_URL for nginx
REACT_APP_API_URL=/api/oam

# Environment name: local | production
REACT_APP_ENV=local

# Public URL prefix the app is served under
REACT_APP_PUBLIC_URL=/netlox

# Dev server
PORT=3000
HTTPS=true
WDS_SOCKET_PORT=0

# nginx template variables (Docker deployments, see docker-entrypoint.sh)
# BACKEND_URL=http://your-backend:8080
# BACKEND_HOST=your-backend
# FRONTEND_URL=http://localhost:3000
# PUBLIC_PATH=/netlox
